<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Battaglia Scanner</title>
<style>
:root{--bg:#0d0f12;--panel:#16191f;--panel2:#1e2229;--line:#2a2f38;--blue:#c8102e;--blueline:#ffc72c;--text:#e6e8eb;--dim:#9aa4b2;--green:#2ea043;--red:#f85149;--amber:#d29922}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;padding-bottom:40px}
header{background:#000;border-bottom:3px solid var(--blue);box-shadow:0 3px 0 var(--blueline);padding:14px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
header h1{font-size:18px;letter-spacing:.5px}
header .sub{color:var(--dim);font-size:12px}
header button{margin-left:auto}
main{max-width:900px;margin:0 auto;padding:16px}
.box{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:12px}
.lbl{font-size:11px;color:var(--dim);letter-spacing:.07em;text-transform:uppercase}
.big{font:600 30px ui-monospace,Menlo,Consolas,monospace;line-height:1.1}
input{background:var(--panel2);border:1px solid var(--line);color:var(--text);padding:10px 12px;border-radius:8px;font-size:15px;width:100%}
input:focus{outline:1px solid var(--blueline)}
#scanin{font:18px ui-monospace,Menlo,Consolas,monospace;padding:14px;margin-top:10px}
.btn{background:var(--blue);color:#fff;border:0;padding:9px 14px;border-radius:8px;cursor:pointer;font-size:14px}
.btn.ghost{background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.btn.sm{padding:5px 10px;font-size:12px}
.msg{margin-top:8px;min-height:1.4em;font-weight:600}
.msg.ok{color:#4ec06a}.msg.err{color:var(--red)}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:8px}
.tile{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:left;cursor:pointer;color:var(--text);font:inherit;min-height:60px}
.tile.run{border-color:var(--green);background:#12301a}
.tile b{display:block}.tile span{font-size:12px;color:var(--dim)}.tile.run span{color:#4ec06a;font-family:ui-monospace,Menlo,monospace;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:14px;margin-top:6px}
td,th{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left}
th{color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.4px}
.mono{font-family:ui-monospace,Menlo,Consolas,monospace}
.pill{display:inline-block;padding:3px 9px;border-radius:11px;font-size:12px;font-weight:600;background:#33270e;color:var(--amber)}
.pill.ok{background:#12301a;color:#4ec06a}
.muted{color:var(--dim);font-size:13px}
.hide{display:none}
</style>
</head>
<body>
<header><h1>Battaglia Scanner</h1><span class="sub">Scan a job ticket, then a machine</span><button class="btn ghost sm" id="setbtn">Settings</button></header>
<main>
  <div class="box hide" id="settings">
    <div class="lbl" style="margin-bottom:6px">Connect to the job sheet</div>
    <p class="muted" style="margin-bottom:8px">Paste the app link from your bookmark (the one ending in <b>?k=…</b>). It is saved on this computer only.</p>
    <input id="applink" type="text" placeholder="https://script.google.com/macros/s/…/exec?k=…">
    <div class="row" style="margin-top:8px"><button class="btn" id="savebtn">Save</button><span class="muted" id="setmsg"></span></div>
  </div>

  <div class="box">
    <div class="row" style="align-items:flex-end;gap:16px">
      <div><div class="lbl">Current job</div><div class="big" id="curjob">—</div></div>
      <div style="flex:1;min-width:180px" id="curinfo" class="muted">Scan a job ticket.</div>
    </div>
    <input id="scanin" type="text" inputmode="none" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Scan a job ticket, an item line, or a machine barcode">
    <div class="msg" id="msg"></div>
    <div class="row" style="margin-top:8px" id="serbox"></div>
  </div>

  <div class="box">
    <div class="row"><b>Running now</b><span class="muted" id="runcount"></span><span style="flex:1"></span><button class="btn ghost sm" data-code="X-STOP-ALL">Stop all</button><button class="btn ghost sm" data-code="X-FINISHED">Finished</button></div>
    <table><thead><tr><th>Station</th><th>Job</th><th>Elapsed</th></tr></thead><tbody id="running"></tbody></table>
  </div>

  <div class="box">
    <b>Stations</b> <span class="muted">Tap to start or stop, same as scanning its barcode.</span>
    <div class="tiles" id="tiles"></div>
  </div>
</main>
<script>
(function(){
"use strict";
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let cfg={url:"",k:""};try{cfg=JSON.parse(localStorage.getItem("bpScanner")||"{}")}catch(e){}
let state=null,last={code:"",t:0},queue=Promise.resolve();

function parseLink(s){try{const u=new URL(String(s).trim());const k=u.searchParams.get("k")||"";u.search="";return {url:u.toString(),k}}catch(e){return null}}
function showSettings(on){$("#settings").classList.toggle("hide",!on);if(on)$("#applink").value=cfg.url?cfg.url+"?k="+cfg.k:""}
$("#setbtn").onclick=()=>showSettings($("#settings").classList.contains("hide"));
$("#savebtn").onclick=async()=>{const c=parseLink($("#applink").value);if(!c||!c.k||!/script\.google\.com/.test(c.url)){$("#setmsg").textContent="That doesn't look like the app link with ?k= at the end.";return}
  cfg=c;try{localStorage.setItem("bpScanner",JSON.stringify(cfg))}catch(e){}
  $("#setmsg").textContent="Checking…";const r=await call({action:"state"});
  if(r.ok){$("#setmsg").textContent="";showSettings(false);msg("Connected.",true)}else $("#setmsg").textContent=r.msg};

async function call(body){
  if(!cfg.url||!cfg.k)return {ok:false,msg:"Open Settings and paste the app link first."};
  try{const res=await fetch(cfg.url,{method:"POST",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(Object.assign({k:cfg.k},body))});
    const r=await res.json();if(r.state){state=r.state;draw()}return r}
  catch(e){return {ok:false,msg:"Could not reach the job sheet. Check the internet connection."}}
}
function msg(t,ok){const m=$("#msg");m.textContent=t||"";m.className="msg "+(ok?"ok":"err")}
function scan(raw){const code=String(raw||"").trim().toUpperCase();if(!code)return;const now=Date.now();
  if(last.code===code&&now-last.t<2000)return; /* scanner double-read */
  last={code,t:now};msg("Working…",true);
  queue=queue.then(async()=>{const r=await call({action:"scan",code});msg(r.msg,r.ok)}).catch(()=>{})}

const dur=ms=>{ms=Math.max(0,Math.round(ms/1000));const h=Math.floor(ms/3600),m=Math.floor(ms%3600/60),s=ms%60;return h?h+"h "+String(m).padStart(2,"0")+"m":m?m+"m "+String(s).padStart(2,"0")+"s":s+"s"};
function draw(){
  if(!state)return;
  $("#curjob").textContent=state.curJob?state.curJob+(state.curLine?"-"+state.curLine:""):"None";
  $("#curinfo").innerHTML=state.job?`<b style="color:var(--text)">${esc(state.job.customer)}</b><div>${esc(state.job.desc)}</div>`:"Scan a job ticket.";
  $("#runcount").textContent="("+state.running.length+")";
  $("#running").innerHTML=state.running.length?state.running.map(t=>`<tr><td><b>${esc(t.station)}</b></td><td class="mono">${t.jobId?esc(t.jobId+(t.lineId?"-"+t.lineId:"")):'<span class="pill">No job</span>'}</td><td class="mono" data-since="${+new Date(t.start)}">${dur(Date.now()-new Date(t.start))}</td></tr>`).join(""):`<tr><td colspan="3" class="muted">Nothing running.</td></tr>`;
  const runBy={};state.running.forEach(t=>runBy[t.station]=t);
  $("#tiles").innerHTML=state.stations.map(s=>{const r=runBy[s.name];return `<button class="tile${r?" run":""}" data-code="${esc(s.code)}"><b>${esc(s.name)}</b><span${r?` data-since="${+new Date(r.start)}"`:""}>${r?dur(Date.now()-new Date(r.start)):"Tap to start"}</span></button>`}).join("")||'<span class="muted">No stations yet. Add them on the Stations tab in the app.</span>';
}
setInterval(()=>document.querySelectorAll("[data-since]").forEach(el=>el.textContent=dur(Date.now()-(+el.dataset.since))),1000);
setInterval(()=>{if(!document.hidden&&cfg.k)call({action:"state"})},15000);
document.addEventListener("click",e=>{const b=e.target.closest("[data-code]");if(b)scan(b.dataset.code);
  else if(!e.target.closest("input,button,a")&&$("#settings").classList.contains("hide"))$("#scanin").focus({preventScroll:true})});
$("#scanin").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();const v=e.target.value;e.target.value="";scan(v)}});

/* USB serial scanner (Chrome/Edge): scans arrive even when this tab is behind other windows */
const SER={port:null,reader:null,buf:"",timer:0};
const serOK=()=>"serial" in navigator;
function serUI(t){$("#serbox").innerHTML=!serOK()?'<span class="muted">USB serial needs Chrome or Edge. Keyboard-mode scanning still works here.</span>':
  SER.port?`<span class="pill ok">Scanner connected (USB serial)</span> <button class="btn ghost sm" id="seroff">Disconnect</button>`:
  `<button class="btn ghost sm" id="seron">Connect scanner (USB serial)</button> <span class="muted">${esc(t||"Optional. For a scanner set to USB-COM mode.")}</span>`;
  const on=$("#seron"),off=$("#seroff");if(on)on.onclick=serConnect;if(off)off.onclick=serOff}
function flush(){clearTimeout(SER.timer);const parts=SER.buf.split(/[\r\n\0]+/);SER.buf=parts.pop();parts.forEach(p=>{if(p.trim())scan(p)});
  if(SER.buf.trim())SER.timer=setTimeout(()=>{const p=SER.buf.trim();SER.buf="";if(p)scan(p)},250)}
async function serOpen(port){try{await port.open({baudRate:9600});SER.port=port;serUI();read(port)}catch(e){serUI("Could not open the scanner. Close any other program using it.")}}
async function read(port){const dec=new TextDecoder();try{while(port.readable&&SER.port===port){SER.reader=port.readable.getReader();try{for(;;){const {value,done}=await SER.reader.read();if(done)break;if(value){SER.buf+=dec.decode(value,{stream:true});flush()}}}finally{try{SER.reader.releaseLock()}catch(e){}SER.reader=null}}}catch(e){}
  if(SER.port===port){SER.port=null;try{await port.close()}catch(e){}serUI("Scanner disconnected. Plug it in and press Connect.")}}
async function serConnect(){try{await serOpen(await navigator.serial.requestPort())}catch(e){serUI("No scanner was chosen.")}}
async function serOff(){const p=SER.port;SER.port=null;try{if(SER.reader)await SER.reader.cancel()}catch(e){}try{if(p)await p.close()}catch(e){}serUI()}
serUI();
if(serOK()){navigator.serial.getPorts().then(ps=>{if(ps.length)serOpen(ps[0])}).catch(()=>{});navigator.serial.addEventListener("connect",async()=>{if(!SER.port){const l=await navigator.serial.getPorts();if(l.length)serOpen(l[0])}})}

if(!cfg.k)showSettings(true);else call({action:"state"});
$("#scanin").focus();
})();
</script>
</body>
</html>
